{
  "name": "estatic",
  "version": "0.4.5",
  "description": "A express static file server",
  "type": "module",
  "bin": {
    "estatic": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "rimraf dist && biome check --write && tsc",
    "dev": "tsc --watch",
    "build": "tsc",
    "check": "biome check --write",
    "format": "biome format --write",
    "lint": "biome lint --write",
    "clean": "rimraf dist"
  },
  "keywords": [
    "express",
    "file",
    "static",
    "server"
  ],
  "author": "nashaofu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nashaofu/estatic.git"
  },
  "bugs": {
    "url": "https://github.com/nashaofu/estatic/issues"
  },
  "homepage": "https://github.com/nashaofu/estatic#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "colors": "^1.4.0",
    "cors": "^2.8.5",
    "detect-port": "^2.1.0",
    "express": "^5.2.1",
    "express-basic-auth": "^1.2.1",
    "morgan": "^1.10.1",
    "open": "^11.0.0",
    "serve-index": "^1.9.1",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.0.1",
    "@types/serve-index": "^1.9.4",
    "@types/yargs": "^17.0.35",
    "rimraf": "^6.1.2",
    "typescript": "^5.9.3"
  }
}
